#!/bin/bash
MOUNT_POINT="/home/user/Drive"

if [ ! -e /dev/fuse ]; then
    echo "FUSE not available. Using rclone sync instead."
    echo "Run: drive-push  or  drive-pull"
    exit 1
fi

mkdir -p "$MOUNT_POINT"

if mountpoint -q "$MOUNT_POINT"; then
    fusermount -u "$MOUNT_POINT"
fi

rclone mount Drive: "$MOUNT_POINT" \
    --daemon \
    --vfs-cache-mode writes \
    --vfs-cache-max-size 100M \
    --dir-cache-time 12h \
    --log-level INFO

echo "Google Drive mounted at $MOUNT_POINT"
